{
  "name": "multistreams-tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --local",
    "check": "npm run build && wrangler types && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "wrangler": "^4.112.0"
  }
}
